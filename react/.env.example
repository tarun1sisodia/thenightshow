# Customer site public environment (Cloudflare Pages variables).
# Never put secrets in this file. Production must never point at staging.

# Backend base URL used to build API and manifest URLs.
VITE_API_BASE_URL=https://<production-api-host>

# Site base path (keep "/" unless the site is served under a subdirectory).
VITE_BASE_PATH=/

# Customer browser auth (Supabase). Public anon/publishable key only —
# never a service-role key.
VITE_SUPABASE_URL=https://<supabase-project>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Feature switch for the React migration fallback.
VITE_REACT_MIGRATION_ENABLED=false

# Catalog release sources. All sections must come from one atomic release
# (same releaseId/manifestVersion). A missing or failing source must fail
# the build — there is no silent fallback.
ROUTE_CATALOG_MANIFEST_URL=
TOUR_PACKAGES_MANIFEST_URL=
LOCAL_PACKAGES_MANIFEST_URL=
TRANSFER_ROUTES_MANIFEST_URL=
CONTENT_MANIFEST_URL=

# Legacy/compat source. Prefer VITE_API_BASE_URL; fail on ambiguity.
CATALOG_API_URL=
